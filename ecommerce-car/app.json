{
  "expo": {
    "name": "ecommerce-car",
    "slug": "ecommerce-car",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ecommercecar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.chitam.ecommercecar"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.chitam.ecommercecar"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "./plugins/withCustomAndroidGradle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
